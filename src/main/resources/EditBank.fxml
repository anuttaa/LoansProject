<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.EditBankController"
            prefHeight="810.0" prefWidth="1440.0"
            style="-fx-background-color: #f5f5f5;">

    <!-- Основной контейнер формы -->
    <VBox alignment="TOP_CENTER" spacing="30"
          AnchorPane.topAnchor="150" AnchorPane.bottomAnchor="150"
          AnchorPane.leftAnchor="350" AnchorPane.rightAnchor="350">

        <!-- Заголовок -->
        <Label text="Редактирование банка" style="-fx-text-fill: #2c3e50; -fx-font-size: 28px; -fx-font-weight: bold;"/>

        <!-- Две колонки с полями -->
        <HBox spacing="50" alignment="CENTER">
            <!-- Левая колонка -->
            <VBox spacing="25">
                <Label text="Название банка:" style="-fx-text-fill: #2c3e50; -fx-font-size: 16px;"/>
                <TextField fx:id="bankNameField" prefWidth="350" prefHeight="40"
                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C0C0C0; -fx-border-radius: 5; -fx-font-size: 14; -fx-padding: 5;"/>

                <Label text="Телефон:" style="-fx-text-fill: #2c3e50; -fx-font-size: 16px;"/>
                <TextField fx:id="phoneField" prefWidth="350" prefHeight="40"
                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C0C0C0; -fx-border-radius: 5; -fx-font-size: 14; -fx-padding: 5;"/>
            </VBox>

            <!-- Правая колонка -->
            <VBox spacing="25">
                <Label text="Email:" style="-fx-text-fill: #2c3e50; -fx-font-size: 16px;"/>
                <TextField fx:id="emailField" prefWidth="350" prefHeight="40"
                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C0C0C0; -fx-border-radius: 5; -fx-font-size: 14; -fx-padding: 5;"/>

                <Label text="Адрес:" style="-fx-text-fill: #2c3e50; -fx-font-size: 16px;"/>
                <TextField fx:id="addressField" prefWidth="350" prefHeight="40"
                           style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #C0C0C0; -fx-border-radius: 5; -fx-font-size: 14; -fx-padding: 5;"/>
            </VBox>
        </HBox>

        <!-- Статусная строка -->
        <Label fx:id="statusLabel" style="-fx-text-fill: #d9534f; -fx-font-size: 14; -fx-text-alignment: center;"
               prefWidth="700" wrapText="true"/>

        <!-- Кнопки -->
        <HBox spacing="40" alignment="CENTER">
            <Button fx:id="backButton" text="Назад" onAction="#handleBack"
                    prefWidth="150" prefHeight="45"
                    style="-fx-background-color: #6c757d; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>

            <Button fx:id="saveButton" text="Сохранить изменения" onAction="#handleSave"
                    prefWidth="250" prefHeight="45"
                    style="-fx-background-color: #28a745; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</AnchorPane>