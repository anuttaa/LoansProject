<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.LoanTypesViewController"
            stylesheets="@css/loanTypes.css">

    <VBox spacing="15" styleClass="main-container"
          AnchorPane.topAnchor="15" AnchorPane.rightAnchor="15"
          AnchorPane.bottomAnchor="15" AnchorPane.leftAnchor="15">

        <HBox spacing="10" styleClass="filter-panel" HBox.hgrow="ALWAYS">
            <Label text="Банк:" styleClass="filter-label"/>
            <ComboBox fx:id="bankCombo" styleClass="filter-combo" prefWidth="180"/>

            <Label text="Тип:" styleClass="filter-label"/>
            <TextField fx:id="typeSearchField" styleClass="filter-field" prefWidth="180"/>

            <Label text="Ставка:" styleClass="filter-label"/>
            <TextField fx:id="minRateField" styleClass="rate-field" prefWidth="70" promptText="от"/>

            <TextField fx:id="maxRateField" styleClass="rate-field" prefWidth="70" promptText="до"/>

            <Button text="Применить" onAction="#handleApplyFilters" styleClass="filter-button"/>
            <Button text="Сбросить" onAction="#handleResetFilters" styleClass="secondary-button"/>
        </HBox>

        <TableView fx:id="loanTypesTable" styleClass="data-table" prefHeight="600">
            <columns>
                <TableColumn fx:id="typeIdColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="typeNameColumn" text="Тип кредита" prefWidth="280"/>
                <TableColumn fx:id="bankNameColumn" text="Банк" prefWidth="220"/>
                <TableColumn fx:id="rateColumn" text="Ставка %" prefWidth="100"/>
                <TableColumn fx:id="effectiveRateColumn" text="Эффективная ставка %" prefWidth="120"/>
                <TableColumn fx:id="actionsColumn" text="Действие" prefWidth="300"/>
            </columns>
        </TableView>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Оформить" onAction="#handleTakeLoan" styleClass="primary-button" prefWidth="150"/>
            <Button text="Назад" onAction="#handleBack" styleClass="secondary-button" prefWidth="100"/>
        </HBox>
    </VBox>
</AnchorPane>