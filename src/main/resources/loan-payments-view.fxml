<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.LoanPaymentsController"
            stylesheets="@css/loanPayments.css"
            prefHeight="810.0" prefWidth="1440.0">

    <!-- Основной контейнер с отступами и центрированием -->
    <VBox alignment="CENTER" spacing="30" styleClass="main-container"
          AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40"
          AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40">

        <!-- Заголовок -->
        <Label fx:id="titleLabel" styleClass="title-label"/>

        <!-- Информация о кредите -->
        <GridPane hgap="20" vgap="15" styleClass="info-grid">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="200"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="300"/>
            </columnConstraints>

            <Label text="Текущий остаток:" styleClass="info-label" GridPane.rowIndex="0"/>
            <Label fx:id="remainingAmountLabel" styleClass="info-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Статус:" styleClass="info-label" GridPane.rowIndex="1"/>
            <Label fx:id="statusLabel" styleClass="info-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Таблицы платежей -->
        <TabPane prefWidth="1200.0" prefHeight="500.0" styleClass="custom-tab-pane">
            <Tab text="История платежей" styleClass="custom-tab">
                <TableView fx:id="paymentsTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="paymentDateColumn" text="Дата" prefWidth="200">
                            <cellValueFactory>
                                <PropertyValueFactory property="paymentDate"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="paymentAmountColumn" text="Сумма" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="amount"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="paymentTypeColumn" text="Тип" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="paymentType"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </Tab>

            <Tab text="График платежей" styleClass="custom-tab">
                <TableView fx:id="scheduleTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="scheduleDateColumn" text="Дата" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="dueDate"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="scheduleAmountColumn" text="Сумма" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="amount"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="principalColumn" text="Основной долг" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="principalPart"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="interestColumn" text="Проценты" prefWidth="150">
                            <cellValueFactory>
                                <PropertyValueFactory property="interestPart"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </Tab>
        </TabPane>

        <!-- Кнопки -->
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Button text="Новый платеж" onAction="#handleNewPayment" styleClass="primary-button" prefWidth="150"/>
            <Button text="Закрыть" onAction="#handleClose" styleClass="secondary-button" prefWidth="150"/>
        </HBox>
    </VBox>
</AnchorPane>