<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.DeleteUserController"
            stylesheets="@css/deleteUser.css"
            prefHeight="810.0" prefWidth="1440.0">

    <!-- Основной контейнер -->
    <VBox alignment="CENTER" spacing="30" AnchorPane.topAnchor="150" AnchorPane.bottomAnchor="150"
          AnchorPane.leftAnchor="400" AnchorPane.rightAnchor="400">

        <!-- Заголовок -->
        <Label text="Удаление пользователя" styleClass="title-label"/>

        <!-- Форма ввода -->
        <VBox spacing="10" styleClass="form-container">
            <Label text="Введите ID пользователя:" styleClass="input-label"/>
            <TextField fx:id="userIdField" styleClass="input-field"/>

            <!-- Кнопки -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Удалить" onAction="#handleDelete" styleClass="danger-button"/>
                <Button text="Назад" onAction="#handleBack" styleClass="secondary-button"/>
            </HBox>
        </VBox>

        <!-- Список пользователей -->
        <VBox spacing="5">
            <Label text="Список пользователей:" styleClass="section-label"/>
            <TextArea fx:id="usersArea" styleClass="info-area"/>
        </VBox>

        <!-- Статус -->
        <VBox spacing="5">
            <Label text="Статус операции:" styleClass="section-label"/>
            <TextArea fx:id="statusLabel" styleClass="info-area"/>
        </VBox>
    </VBox>
</AnchorPane>