<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.LoanApplicationController"
            prefHeight="400" prefWidth="600">

    <GridPane hgap="10" vgap="10" alignment="CENTER"
              AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <columnConstraints>
            <ColumnConstraints prefWidth="150"/>
            <ColumnConstraints prefWidth="300"/>
        </columnConstraints>

        <Label text="Тип кредита:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="typeLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Банк:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="bankLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Процентная ставка:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="rateLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Сумма кредита:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="amountField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Дата начала:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startDatePicker" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Срок (месяцев):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Spinner fx:id="termSpinner" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT"
          AnchorPane.bottomAnchor="20" AnchorPane.rightAnchor="20">
        <Button text="Отмена" onAction="#handleCancel"/>
        <Button text="Оформить" onAction="#handleSubmit" defaultButton="true"/>
    </HBox>
</AnchorPane>